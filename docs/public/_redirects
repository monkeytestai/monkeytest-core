# Production docs.monkeytest.ai is hosted on Vercel, which does not read
# this file (it is served as a static asset). Vercel clean URLs are set in
# /vercel.json. The rules below matter only if this same VitePress output is
# deployed to Cloudflare Pages or Netlify.
#
# Status 200 is a rewrite: /guide/quick-start serves guide/quick-start.html.
# Existing .html files are served directly, so these rules do not turn
# quick-start.html into quick-start.html.html.
/guide/*       /guide/:splat.html       200
/reference/*   /reference/:splat.html   200

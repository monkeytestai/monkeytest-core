{
  "name": "@monkeytestai/monkeytester",
  "version": "0.7.0-beta.1",
  "description": "Open-source AI exploratory testing engine. Crawls a real browser with Playwright, plans flows with an LLM, executes with screenshots, and reports deduplicated bugs. Works with OpenAI, Gemini, Anthropic, Mistral, Groq, or any OpenAI-compatible endpoint.",
  "license": "AGPL-3.0-only",
  "author": "MonkeyTest",
  "homepage": "https://docs.monkeytest.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monkeytestai/monkeytester.git"
  },
  "bugs": {
    "url": "https://github.com/monkeytestai/monkeytester/issues"
  },
  "keywords": [
    "monkeytest",
    "monkeytester",
    "ai-testing",
    "exploratory-testing",
    "playwright",
    "browser-automation",
    "qa",
    "e2e",
    "llm",
    "openai",
    "gemini",
    "anthropic",
    "claude",
    "mistral",
    "groq",
    "ollama",
    "openrouter",
    "bug-detection",
    "test-automation",
    "agent",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "monkeytest": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -f .tsbuildinfo && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "explore": "tsx src/cli.ts explore",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo",
    "prepack": "npm run clean && npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
    "@mistralai/mistralai": "^1.15.1",
    "openai": "^4.77.0",
    "playwright": "^1.50.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7",
    "vue": "^3.5.33"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
